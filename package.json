{
  "name": "autriders",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run start:dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "backup": "bash scripts/create-backup.sh"
  }
}
